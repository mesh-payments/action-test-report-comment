{
    "env": {
        "node": true,
        "es2022": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "commonjs"
    },
    "ignorePatterns": ["dist/", "node_modules/", "test/fixtures/"],
    "rules": {
        "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
    }
}
